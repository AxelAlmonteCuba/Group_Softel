{
    # Email de contacto opcional para alertas de certificados de Let's Encrypt
    email contacto@g-softel.com
}

# ==============================================================================
# 1. PRODUCCIÓN OFICIAL (Puerto 443 Estándar)
# ==============================================================================
api.g-softel.com, www.api.g-softel.com {
    # Redirección canónica de www hacia api.g-softel.com
    @www host www.api.g-softel.com
    redir @www https://api.g-softel.com{uri} permanent

    # Proxy inverso hacia el backend de producción
    reverse_proxy backend-prod:3000

    # Compresión de alto rendimiento
    encode zstd gzip

    # Cabeceras de protección y seguridad
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ==============================================================================
# 2. PRUEBAS / DESARROLLO CONTINUO (Puerto 8443)
# ==============================================================================
api.g-softel.com:8443 {
    # Proxy inverso hacia el backend de desarrollo
    reverse_proxy backend-dev:3000

    # Compresión de alto rendimiento
    encode zstd gzip

    # Cabeceras de seguridad
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
